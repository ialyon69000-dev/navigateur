# InfinityFree - Rewrite API to PHP files + Security headers
RewriteEngine On

# Page d'accueil : la version PHP (pré-rendu pour les robots / LLM) prime
DirectoryIndex index.php index.html

# Fichiers d'indexation générés dynamiquement (URL absolue correcte quel que
# soit le domaine) : /robots.txt, /sitemap.xml, /llms.txt
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^robots\.txt$ robots.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^llms\.txt$ llms.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/me$ api/me.php [L,QSA]
RewriteRule ^api/news$ api/news.php [L,QSA]
RewriteRule ^api/visit$ api/visit.php [L,QSA]
RewriteRule ^api/visits$ api/visits.php [L,QSA]
RewriteRule ^api/visits\.json$ api/visits.php [L,QSA]
RewriteRule ^api/health$ api/health.php [L,QSA]
RewriteRule ^api/auth/challenge$ api/auth/challenge.php [L,QSA]
RewriteRule ^api/auth/login$ api/auth/login.php [L,QSA]
RewriteRule ^api/auth/register$ api/auth/register.php [L,QSA]
RewriteRule ^api/auth/me$ api/auth/me.php [L,QSA]
RewriteRule ^api/auth/logout$ api/auth/logout.php [L,QSA]
RewriteRule ^api/dispatches$ api/dispatches.php [L,QSA]
RewriteRule ^api/messages$ api/messages.php [L,QSA]

# Prevent direct access to data
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set Referrer-Policy "no-referrer"
    Header set X-Content-Type-Options "nosniff"
    Header set Permissions-Policy "geolocation=(self)"
</IfModule>

# Cache static assets 1h
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 1 hour"
    ExpiresByType image/png "access plus 1 hour"
</IfModule>
